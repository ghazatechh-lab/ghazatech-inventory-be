"""Idempotent Ghazatech demo data. Execute via Django manage.py shell < this_file.
Never resets or deletes records. Use only in development/test databases.
"""
import os
from datetime import date, datetime, timezone
from decimal import Decimal
from django.db import transaction, connections
from django.contrib.auth import get_user_model
from apps.branches.models import Branch
from apps.branch_data.models import BranchDatabaseProfile
from apps.branch_data.services import clear_branch_database_cache
from apps.hrms.models import Designation, Employee, PayrollRun, PayrollEntry
from apps.inventory.models import Brand, Category, Product, ProductStock

D = lambda x: Decimal(str(x))
assert os.getenv('CONFIRM_TEST_SEED') == 'YES', 'Set CONFIRM_TEST_SEED=YES to create demo data.'

branches = [
    ('BR01','Ghaza Computer - Main Branch','VAT','vat',False),
    ('BR02','Sharjah','NON_VAT','non_vat',False),
    ('BR03','Combined / Virtual','MASTER','default',True),
]
# All shared identifiers are on the default database.
with transaction.atomic(using='default'):
    branch_by_code={}
    for code,name,mode,alias,combined in branches:
        branch,created=Branch.objects.using('default').get_or_create(branch_code=code, defaults=dict(branch_name=name,branch_type=mode,is_active=True))
        branch_by_code[code]=branch
        BranchDatabaseProfile.objects.using('default').update_or_create(branch=branch,defaults=dict(mode=mode,database_alias=alias,is_master_inventory=False,show_combined_reports=combined,is_active=True))
    clear_branch_database_cache()

    User=get_user_model()
    email=os.getenv('TEST_ADMIN_EMAIL','admin@ghazatech.local').strip()
    password=os.getenv('TEST_ADMIN_PASSWORD','')
    if not password or len(password)<12:
        raise RuntimeError('Set TEST_ADMIN_PASSWORD to a strong password (12+ characters). No default password is provided.')
    admin,created=User.objects.using('default').get_or_create(email=email,defaults=dict(username='ghaza_test_admin',first_name='Test',last_name='Admin',full_name='Test Admin',branch=branch_by_code['BR03'],is_active=True,is_staff=True,is_superuser=True))
    if created:
        admin.set_password(password)
        admin.save(using='default')
    else:
        print('Admin email already exists: existing password/permissions unchanged')

    sample=[
       ('Ahmed','Khan','Technician','BR01',3500,500),
       ('Mohammed','Ali','Sales Executive','BR01',4000,800),
       ('Fathima','Rahman','Accountant','BR01',4500,1000),
       ('Arjun','Nair','Storekeeper','BR01',3200,400),
       ('Aisha','Hassan','Receptionist','BR01',3000,500),
       ('Rashid','Ahmed','Manager','BR02',6500,1500),
       ('Sana','Farooq','HR Executive','BR02',4200,800),
       ('Vishnu','Kumar','IT Support','BR02',3800,600),
       ('Nabeel','Salim','Driver','BR02',2800,400),
       ('Priya','Menon','Supervisor','BR02',5000,1000),
    ]
    employees=[]
    for i,(first,last,title,code,basic,allow) in enumerate(sample,1):
        des,_=Designation.objects.using('default').get_or_create(name=title,defaults={'designation_name':title})
        employee,_=Employee.objects.using('default').get_or_create(employee_code=f'DEMO-EMP-{i:03}', defaults=dict(first_name=first,last_name=last,designation=des,branch=branch_by_code[code],joining_date=date(2026,1,1),basic_salary=D(basic),allowances=D(allow),employment_status='ACTIVE',employment_type='FULL_TIME',is_active=True))
        employees.append(employee)
    periods=[(2026,7),(2026,8),(2026,9)]
    for code in ('BR01','BR02'):
        branch=branch_by_code[code]
        for yr,mon in periods:
            period=f'{yr}-{mon:02}'
            run,_=PayrollRun.objects.using('default').get_or_create(branch=branch,period=period,salary_type='REGULAR', defaults=dict(payroll_date=date(yr,mon,28),status='COMPLETED',generated_by=admin))
            totals=dict(gross=D(0),deductions=D(0),net=D(0))
            for i,employee in enumerate(employees,1):
                if employee.branch_id!=branch.id: continue
                gross=D(employee.basic_salary or 0)+D(employee.allowances or 0)
                ded=D(100+i*20)
                net=gross-ded
                status='PAID' if mon in (7,8) else 'PENDING'
                entry,_=PayrollEntry.objects.using('default').get_or_create(employee=employee,period=period,salary_type='REGULAR', defaults=dict(payroll_run=run,branch=branch,payroll_date=date(yr,mon,28),basic_salary=employee.basic_salary or 0,allowances=employee.allowances or 0,gross_salary=gross,deductions=ded,net_salary=net,balance_payable=D(0) if status=='PAID' else net,status=status,paid_at=datetime(yr,mon,28,tzinfo=timezone.utc) if status=='PAID' else None,total_period_days=D(30),payable_days=D(30),salary_calculation_method='FULL',paid_by='Test Seed' if status=='PAID' else ''))
                if entry.payroll_run_id==run.pk:
                    totals['gross']+=entry.gross_salary
                    totals['deductions']+=entry.deductions
                    totals['net']+=entry.net_salary
            # The run may already have real entries: recompute authoritative totals from its attached entries.
            from django.db.models import Sum
            agg=PayrollEntry.objects.using('default').filter(payroll_run=run).aggregate(gross=Sum('gross_salary'),deductions=Sum('deductions'),net=Sum('net_salary'))
            run.total_gross=agg['gross'] or 0
            run.total_deductions=agg['deductions'] or 0
            run.total_net=agg['net'] or 0
            run.save(using='default',update_fields=['total_gross','total_deductions','total_net'])
print('Seeded 3 branch definitions, one admin if absent, 10 demo employees and up to 30 payroll entries.')

# Physical inventory is in its respective database; never put stock on BR03.
items=[
 ('DEMO-SSD-512','512GB SSD','Storage','Kingston',90,145,20),
 ('DEMO-RAM-8','8GB DDR4 RAM','Memory','Crucial',45,75,30),
 ('DEMO-BATT-01','Laptop Battery','Spare Parts','Generic',65,110,14),
 ('DEMO-CHARGER','65W Laptop Charger','Accessories','Generic',30,65,25),
 ('DEMO-MOUSE','USB Mouse','Accessories','Logitech',15,30,40),
]
# Physical branch records need mirrored branch ids to satisfy FK constraints.
for code,alias in [('BR01','vat'),('BR02','non_vat')]:
    if alias not in connections:
        print(f'{alias} database missing; skipping physical inventory')
        continue
    try:
        with transaction.atomic(using=alias):
            master_branch=branch_by_code[code]
            physical_branch=Branch.objects.using(alias).filter(pk=master_branch.pk).first()
            if physical_branch and physical_branch.branch_code!=code:
                raise RuntimeError(f'{alias}: branch ID {master_branch.pk} belongs to {physical_branch.branch_code}; refuse to overwrite')
            if not physical_branch:
                physical_branch=Branch(pk=master_branch.pk,branch_code=code,branch_name=master_branch.branch_name,branch_type=code,is_active=True)
                physical_branch.save(using=alias,force_insert=True)
            for sku,name,category_name,brand_name,cost,price,qty in items:
                brand,_=Brand.objects.using(alias).get_or_create(name=brand_name)
                category,_=Category.objects.using(alias).get_or_create(name=category_name)
                actual_sku=f'{code}-{sku}'
                product,_=Product.objects.using(alias).get_or_create(branch_id=physical_branch.pk,sku=actual_sku,defaults=dict(product_name=name,brand_id=brand.pk,category_id=category.pk,condition='NEW',tax_treatment='VAT' if code=='BR01' else 'NON_VAT',reorder_level=5))
                ProductStock.objects.using(alias).get_or_create(product_id=product.pk,branch_id=physical_branch.pk,variant=None,warehouse='Main',defaults=dict(current_stock=qty,reorder_level=5,average_unit_cost=D(cost),average_unit_cost_excluding_vat=D(cost),last_purchase_cost=D(cost),last_purchase_cost_excluding_vat=D(cost),last_tax_treatment='VAT' if code=='BR01' else 'NON_VAT',last_vat_percentage=D(5 if code=='BR01' else 0)))
        print(f'{code}: up to 5 products and 5 stock records in {alias}')
    except Exception as e:
        print(f'FAILED inventory seed on {alias}: {type(e).__name__}: {e}')
        print('Rolled back this physical database only. Check migrations and FK mirroring before retrying.')

print('Done. Demo records have DEMO- codes. Existing records were not deleted or reset.')
